{
  "installCommand": "npm install --omit=dev --no-audit --no-fund",
  "crons": [
    {
      "path": "/api/cron/market",
      "schedule": "0 3 * * *"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "s-maxage=10800, stale-while-revalidate=10800" }]
    },
    {
      "source": "/ur",
      "headers": [{ "key": "Cache-Control", "value": "s-maxage=10800, stale-while-revalidate=10800" }]
    },
    {
      "source": "/rates",
      "headers": [{ "key": "Cache-Control", "value": "s-maxage=10800, stale-while-revalidate=10800" }]
    },
    {
      "source": "/rates/:path*",
      "headers": [{ "key": "Cache-Control", "value": "s-maxage=10800, stale-while-revalidate=10800" }]
    },
    {
      "source": "/ur/rates",
      "headers": [{ "key": "Cache-Control", "value": "s-maxage=10800, stale-while-revalidate=10800" }]
    },
    {
      "source": "/ur/rates/:path*",
      "headers": [{ "key": "Cache-Control", "value": "s-maxage=10800, stale-while-revalidate=10800" }]
    },
    {
      "source": "/gold-rates",
      "headers": [{ "key": "Cache-Control", "value": "s-maxage=10800, stale-while-revalidate=10800" }]
    },
    {
      "source": "/gold-rates/:path*",
      "headers": [{ "key": "Cache-Control", "value": "s-maxage=10800, stale-while-revalidate=10800" }]
    },
    {
      "source": "/ur/gold-rates",
      "headers": [{ "key": "Cache-Control", "value": "s-maxage=10800, stale-while-revalidate=10800" }]
    },
    {
      "source": "/ur/gold-rates/:path*",
      "headers": [{ "key": "Cache-Control", "value": "s-maxage=10800, stale-while-revalidate=10800" }]
    }
  ],
  "redirects": [
    { "source": "/listings", "destination": "/", "permanent": true },
    { "source": "/listings/:path*", "destination": "/", "permanent": true },
    { "source": "/property", "destination": "/", "permanent": true },
    { "source": "/property/:path*", "destination": "/", "permanent": true },
    { "source": "/properties", "destination": "/", "permanent": true },
    { "source": "/properties/:path*", "destination": "/", "permanent": true },
    { "source": "/cities", "destination": "/", "permanent": true },
    { "source": "/cities/:path*", "destination": "/", "permanent": true },
    { "source": "/post-ad", "destination": "/", "permanent": true },
    { "source": "/login", "destination": "/", "permanent": true },
    { "source": "/login/:path*", "destination": "/", "permanent": true },
    { "source": "/search", "destination": "/", "permanent": true },
    { "source": "/search/:path*", "destination": "/", "permanent": true },
    { "source": "/register", "destination": "/", "permanent": true },
    { "source": "/dashboard", "destination": "/", "permanent": true },
    { "source": "/dashboard/:path*", "destination": "/", "permanent": true },
    { "source": "/agents", "destination": "/", "permanent": true },
    { "source": "/agents/:path*", "destination": "/", "permanent": true },
    { "source": "/contact-agent", "destination": "/", "permanent": true },
    { "source": "/signup", "destination": "/", "permanent": true },
    { "source": "/sign-up", "destination": "/", "permanent": true },
    { "source": "/account", "destination": "/", "permanent": true },
    { "source": "/profile", "destination": "/", "permanent": true },
    { "source": "/islamabad", "destination": "/", "permanent": true },
    { "source": "/islamabad/:path*", "destination": "/", "permanent": true },
    { "source": "/rawalpindi", "destination": "/", "permanent": true },
    { "source": "/rawalpindi/:path*", "destination": "/", "permanent": true },
    { "source": "/lahore", "destination": "/", "permanent": true },
    { "source": "/lahore/:path*", "destination": "/", "permanent": true },
    { "source": "/karachi", "destination": "/", "permanent": true },
    { "source": "/karachi/:path*", "destination": "/", "permanent": true },
    { "source": "/peshawar", "destination": "/", "permanent": true },
    { "source": "/peshawar/:path*", "destination": "/", "permanent": true },
    { "source": "/multan", "destination": "/", "permanent": true },
    { "source": "/faisalabad", "destination": "/", "permanent": true },
    { "source": "/quetta", "destination": "/", "permanent": true },
    { "source": "/hyderabad", "destination": "/", "permanent": true },
    { "source": "/sialkot", "destination": "/", "permanent": true },
    { "source": "/gujranwala", "destination": "/", "permanent": true },
    { "source": "/abbottabad", "destination": "/", "permanent": true },
    { "source": "/sargodha", "destination": "/", "permanent": true },
